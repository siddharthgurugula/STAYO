<% layout("/layout/boilerplate") %>

<div class="row mt-3">
  <div class="alert alert-danger col-6 offset-3" role="alert">

    <svg width="20" height="20" class="me-2" role="img">
      <use xlink:href="#exclamation-triangle-fill"></use>
    </svg>

    <h4 class="alert-heading"><%= message %></h4>
    <p><%= err.stack %></p>

  </div>
</div>