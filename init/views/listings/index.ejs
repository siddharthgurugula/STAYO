
<% layout("/layout/boilerplate") %>

<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }

    .filter {
        text-align: center;
        margin-right: 2rem;
        margin-top: 2rem;
    }

    .filter p {
        font-size: 0.8rem;
    }

    .tax-info {
        display: none;
    }

    .tax-toggle {
        border: 1px solid black;
        border-radius: 1rem;
        height: 3.5rem;
        padding: 1rem;
        margin-left: 2rem;
        display: flex;
        align-items: center;
    }

    .search-message {
        margin: 1.5rem 0;
    }
</style>

<div id="filters">
    <div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic cities</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </div>

    <div class="filter">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castle</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing pools</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </div>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input
                class="form-check-input"
                type="checkbox"
                id="switchDisabledLabel"
                role="switch"
            >
            <label class="form-check-label" for="switchDisabledLabel">
                Display total after taxes
            </label>
        </div>
    </div>
</div>

<% if (search) { %>
    <h5 class="search-message">
        Search results for: "<%= search %>"
        <a href="/listings" class="btn btn-sm btn-outline-secondary ms-2">
            Clear search
        </a>
    </h5>
<% } %>

<% if (allListings.length === 0) { %>
    <div class="search-message">
        <h4>No listings found</h4>
        <p>Try another destination, location, or listing name.</p>
        <a href="/listings" class="btn btn-outline-dark">View all listings</a>
    </div>
<% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for (let listing of allListings) { %>
            <div class="col mb-4 listing-card">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card">
                        <img
                            src="<%= listing.image.url %>"
                            class="card-img-top"
                            alt="listing image"
                            style="height: 20rem; object-fit: cover;"
                        />

                        <div class="card-img-overlay"></div>

                        <div class="card-body">
                            <h5 class="card-title">
                                <%= listing.title %>
                            </h5>

                            <p class="card-text">
                                ₹<%= Number(listing.price).toLocaleString("en-IN") %> / night
                                <i class="tax-info">&nbsp; &nbsp;+18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
<% } %>

<script>
    const taxSwitch = document.getElementById("switchDisabledLabel");

    taxSwitch.addEventListener("change", () => {
        const taxInfo = document.getElementsByClassName("tax-info");

        for (const info of taxInfo) {
            info.style.display = taxSwitch.checked ? "inline" : "none";
        }
    });
</script>
